# ==========================================
# Signalpost Configuration
# ==========================================

# Server Settings
ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=signalpost.db

# LLM Configuration
# Supported providers: "mock", "openai", "gemini", "groq", "openrouter", "ollama"
# Leave as "mock" for zero-cost deterministic extraction or enter your API key below
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0

# Search Provider Configuration
# Supported providers: "mock", "duckduckgo", "tavily", "serpapi"
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Norwegian Official Registry API (Brønnøysundregistrene - free public open API)
BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api
HTTP_TIMEOUT_SECONDS=15
